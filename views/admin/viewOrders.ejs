<%- include('../partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h2>All Orders</h2>
  <a href="/admin" class="btn btn-secondary btn-sm">← Back to Dashboard</a>
</div>

<% if (orders.length === 0) { %>
  <div class="alert alert-info">No orders placed yet.</div>
<% } else { %>
  <% orders.forEach(order => { %>
    <div class="card mb-3 shadow-sm">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-start">
          <div>
            <h6 class="mb-1">
              Customer: <%= order.user ? order.user.name : 'Unknown' %>
              (<%= order.user ? order.user.email : '-' %>)
            </h6>
            <p class="text-muted small mb-1">Placed on <%= order.createdAt.toDateString() %></p>
          </div>
          <span class="badge bg-info text-dark text-capitalize"><%= order.status %></span>
        </div>

        <ul class="list-unstyled mb-2 mt-2">
          <% order.items.forEach(item => { %>
            <li><%= item.name %> × <%= item.quantity %> — ₹<%= item.price * item.quantity %></li>
          <% }) %>
        </ul>

        <p class="mb-1"><strong>Total:</strong> ₹<%= order.totalAmount %></p>
        <p class="mb-1"><strong>Payment:</strong> <%= order.paymentMethod %></p>
        <p class="mb-2">
          <strong>Deliver to:</strong>
          <%= order.address.fullName %>, <%= order.address.address %>, <%= order.address.phone %>
        </p>

        <form action="/admin/orders/<%= order._id %>/status" method="POST" class="d-flex gap-2 align-items-center" style="max-width: 300px;">
          <select name="status" class="form-select form-select-sm">
            <option value="placed" <%= order.status === 'placed' ? 'selected' : '' %>>Placed</option>
            <option value="shipped" <%= order.status === 'shipped' ? 'selected' : '' %>>Shipped</option>
            <option value="delivered" <%= order.status === 'delivered' ? 'selected' : '' %>>Delivered</option>
          </select>
          <button type="submit" class="btn btn-sm btn-primary">Update</button>
        </form>
      </div>
    </div>
  <% }) %>
<% } %>

<%- include('../partials/footer') %>