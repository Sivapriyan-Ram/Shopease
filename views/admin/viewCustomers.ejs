<%- include('../partials/header') %>

<h2>All Customers</h2>

<a href="/admin" class="btn btn-secondary btn-sm mb-3">← Back to Dashboard</a>

<% if (customers.length === 0) { %>
  <div class="alert alert-info">No customers registered yet.</div>
<% } else { %>
  <table class="table table-striped table-bordered">
    <thead class="table-dark">
      <tr>
        <th>Name</th>
        <th>Email</th>
        <th>Joined</th>
      </tr>
    </thead>
    <tbody>
      <% customers.forEach(c => { %>
        <tr>
          <td><%= c.name %></td>
          <td><%= c.email %></td>
          <td><%= c.createdAt.toDateString() %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>

<%- include('../partials/footer') %>