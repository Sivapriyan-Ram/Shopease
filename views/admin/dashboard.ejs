<%- include('../partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h2>Admin Dashboard</h2>
  <a href="/logout" class="btn btn-outline-danger btn-sm">Logout</a>
</div>

<p>Welcome, <strong><%= name %></strong> 👋</p>

<div class="row g-3 mb-4">
  <div class="col-md-4">
    <div class="card p-3 text-center shadow-sm">
      <h5>Total Products</h5>
      <h2><%= productCount %></h2>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card p-3 text-center shadow-sm">
      <h5>Total Customers</h5>
      <h2><%= customerCount %></h2>
    </div>
  </div>
</div>

<div class="d-flex gap-2">
  <a href="/admin/products/add" class="btn btn-primary">+ Add Product</a>
  <a href="/admin/products" class="btn btn-outline-primary">Manage Products</a>
  <a href="/admin/orders" class="btn btn-secondary">View Orders</a>
  <a href="/admin/customers" class="btn btn-secondary">View Customers</a>
</div>

<%- include('../partials/footer') %>