<%- include('../partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h2>Welcome, <%= name %> 👋</h2>
  <div>
    <a href="/orders" class="btn btn-outline-secondary btn-sm">My Orders</a>
    <a href="/cart" class="btn btn-outline-primary btn-sm">🛒 Cart</a>
    <a href="/logout" class="btn btn-outline-danger btn-sm">Logout</a>
  </div>
</div>

<h4 class="mb-3">Available Products</h4>

<% if (products.length === 0) { %>
  <div class="alert alert-info">No products available right now. Check back soon!</div>
<% } else { %>
  <div class="row g-4">
    <% products.forEach(product => { %>
      <div class="col-md-4">
        <div class="card h-100 shadow-sm">
          <img src="<%= product.image %>" class="card-img-top" alt="<%= product.name %>" style="height: 200px; object-fit: cover;" />
          <div class="card-body d-flex flex-column">
            <h5 class="card-title"><%= product.name %></h5>
            <p class="card-text text-muted small"><%= product.category %></p>
            <p class="card-text fw-bold">₹<%= product.price %></p>
            <a href="/product/<%= product._id %>" class="btn btn-primary mt-auto">View Details</a>
          </div>
        </div>
      </div>
    <% }) %>
  </div>
<% } %>

<%- include('../partials/footer') %>