<%- include('../partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h2>My Orders</h2>
  <a href="/dashboard" class="btn btn-secondary btn-sm">← Continue Shopping</a>
</div>

<% if (orders.length === 0) { %>
  <div class="alert alert-info">You haven't placed any orders yet.</div>
<% } else { %>
  <% orders.forEach(order => { %>
    <div class="card mb-3 shadow-sm">
      <div class="card-body">
        <div class="d-flex justify-content-between">
          <h6>Order placed on <%= order.createdAt.toDateString() %></h6>
          <span class="badge bg-info text-dark text-capitalize"><%= order.status %></span>
        </div>
        <ul class="list-unstyled mb-2">
          <% order.items.forEach(item => { %>
            <li><%= item.name %> × <%= item.quantity %> — ₹<%= item.price * item.quantity %></li>
          <% }) %>
        </ul>
        <p class="fw-bold mb-0">Total: ₹<%= order.totalAmount %></p>
        <p class="text-muted small mb-0">Payment: <%= order.paymentMethod %></p>
      </div>
    </div>
  <% }) %>
<% } %>

<%- include('../partials/footer') %>